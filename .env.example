# Copy to .env and edit. Atmos has no secrets: every data source is free and keyless.

# Host port for the nginx container.
ATMOS_PORT=8085

# Version of the DoBIH CSV in data/raw/DoBIH.csv (shown in the data credits).
DOBIH_VERSION=18.6

# Container time zone, for logs.
TZ=Europe/London

# Defaults for a browser that hasn't chosen yet. Baked in at build time, so changing
# them needs `docker compose up -d --build`. Choices made in the app's Settings win.
# Theme: light or dark.
ATMOS_DEFAULT_THEME=light
# Wind speed unit: kmh or mph.
ATMOS_DEFAULT_WIND_UNIT=kmh

# Only if you switch docker-compose.yml to the shared proxy network.
# PROXY_NETWORK=proxy
