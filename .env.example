# Copy to .env and edit. Atmos has no secrets: every data source is free and keyless.

# Host port for the nginx container.
ATMOS_PORT=8085

# Container time zone, for logs.
TZ=Europe/London

# Defaults for a browser that hasn't chosen yet; choices made in the app's Settings win.
# Applied when the container starts: `docker compose up -d` after changing them.
# Theme: light or dark.
ATMOS_DEFAULT_THEME=light
# Wind speed unit: kmh or mph.
ATMOS_DEFAULT_WIND_UNIT=kmh

# Version of the DoBIH CSV, shown in the data credits. Leave empty when the file keeps
# its downloaded name (e.g. DoBIH_v18_6.csv): it's read from that.
DOBIH_VERSION=

# Only if you switch docker-compose.yml to the shared proxy network.
# PROXY_NETWORK=proxy
