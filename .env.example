# Copy to .env and edit. Every data source is free and keyless; the only secret is the
# optional email login for alerts, at the end.

# Host port for the nginx container.
ATMOS_PORT=8085

# Container time zone, for logs.
TZ=Europe/London

# Defaults for a browser that hasn't chosen yet; choices made in the app's Settings win.
# Applied when the container starts: `docker compose up -d` after changing them.
# Theme: light or dark.
ATMOS_DEFAULT_THEME=light
# Wind speed unit: kmh or mph.
ATMOS_DEFAULT_WIND_UNIT=kmh

# Version of the DoBIH CSV, shown in the data credits. Leave empty when the file keeps
# its downloaded name (e.g. DoBIH_v18_6.csv): it's read from that.
DOBIH_VERSION=

# Only if you switch docker-compose.yml to the shared proxy network.
# PROXY_NETWORK=proxy

# --- Alerts (the optional atmos-alerts container) -------------------------------------
# The address people use for Atmos, for links in alert emails.
ATMOS_URL=http://localhost:8085
# Email sending. For SMTP2GO: the SMTP user from Sending > SMTP Users, and an address on a
# domain verified under Sending > Verified Senders.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# Who the emails come from, e.g. Atmos <alerts@example.com>.
ALERTS_FROM=
